# Copy to .env.local. The database URLs match docker-compose.yml.
DATABASE_URL=postgres://chat_app:chat_app_local@localhost:5443/chat_with_db
READONLY_DATABASE_URL=postgres://chat_readonly:chat_readonly_local@localhost:5443/chat_with_db

# Set at least one key. With both set, Anthropic is used unless LLM_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5-mini
# Embeddings for retrieval use OpenAI; without OPENAI_API_KEY the full schema is sent instead.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Safety limits for generated SQL.
# QUERY_ROW_LIMIT=500
# QUERY_TIMEOUT_MS=5000
